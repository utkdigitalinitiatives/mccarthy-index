{#
/**
 * @file
 * UTK Custom - 403 Forbidden Page template.
 *
 * This template is used to render the 403 Forbidden error page with custom
 * styling and layout.
 *
 * Available variables:
 * - attributes: HTML attributes for the main container.
 * - search_endpoint: The URL for the search functionality.
 *
 * Customizations:
 * - Displays a custom 403 error message with a prominent title and description.
 * - Includes a search bar for users to find relevant content.
 * - Provides a "Back to Homepage" button for easy navigation.
 * - Renders the site header, library footer, and campus footer for consistent branding.
 *
 * Included templates:
 * - utk--header.html.twig: Renders the site header.
 * - utk--search-header.html.twig: Displays the search bar.
 * - utk--large-button.html.twig: Renders a large button for navigation.
 * - utk--library-footer.html.twig: Renders the library footer.
 * - utk--campus-footer.html.twig: Renders the campus footer.
 * - utk--campus-footer-subfooter.html.twig: Renders the subfooter for the campus footer.
 *
 * @see page.html.twig
 */
#}
{% extends "page--public.html.twig" %}

{%
    set classes = [
        'container-fluid',
        'mb-4',
        'pb-4',
        'px-0',
        'mx-0',
        'text-smokey',
        'link-link',
    ]
%}

{% block main_content %}
    <main {{ attributes.addClass(classes)}} >
        <div class='container-fluid d-lg-flex justify-content-center utk-article'>
            <div class='row pt-4 px-2 utk-section-body text-center'>
                <h1><span class='fw-bolder'>403</span> Forbidden</h1>
                <p class='mx-auto'>You don't have permission to access this page.</p>
                 {# {% include "@mccarthy_theme/templates/components/utk--search-header.html.twig" with {search_url:search_endpoint} %} #}
                <div>
                    {# {% include "@mccarthy_theme/templates/components/utk--large-button.html.twig" with {title:"Back to Homepage", url:"/"  } %} #}
                </div>
            </div> 
        </div>
    </main>
{% endblock %}
