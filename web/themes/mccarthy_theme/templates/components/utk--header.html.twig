{#
/**
 * @file
 * UTK Custom - Header template.
 *
 * This template is used to render the site header with custom styling and layout.
 *
 * Available variables:
 * - search_endpoint: The endpoint for the search functionality.
 * - placeholder: The placeholder text for the search form.
 *
 * Customizations:
 * - Displays the site logo and title with a link to the homepage.
 * - Includes a responsive navigation menu with dropdowns for desktop and mobile views.
 * - Provides quick links to services like "Get Help," "My Account," and "Hours."
 * - Integrates a search form with a dynamic placeholder.
 * - Ensures responsive design using Bootstrap 5.3.
 *
 * Included templates:
 * - utk--search-header.html.twig: Renders the search form in the header.
 *
 * @see template_preprocess_page()
 */
#}

{% set search_endpoint = "/search-results" %}
{% set placeholder = "Search our site..." %}

{% set find_dropdown_links = [
    { 'url': 'https://utk.primo.exlibrisgroup.com/discovery/search?vid=01UTN_KNOXVILLE:01UTK', 'text': 'One Search', 'li_extra_class': 'text-smokey', 'external_icon': false },
    { 'url': '/services', 'text': 'Services', 'external_icon': false },
    { 'url': 'https://libguides.utk.edu/databases', 'text': 'Databases', 'external_icon': true },
    { 'url': 'https://libguides.utk.edu/', 'text': 'Research Guides', 'external_icon': true },
    { 'url': 'https://digital.lib.utk.edu/', 'text': 'Digital Collections', 'external_icon': true },
    { 'url': '/spaces', 'text': 'Spaces', 'external_icon': false },
    { 'url': '/about', 'text': 'About the Libraries', 'external_icon': false }
] %}

{% set mobile_nav_links = [
    { 'url': 'https://utk.primo.exlibrisgroup.com/discovery/search?vid=01UTN_KNOXVILLE:01UTK', 'text': 'One Search', 'external_icon':true  },
    { 'url': 'https://libguides.utk.edu/', 'text': 'Research Guides', 'external_icon':true },
    { 'url': '/services', 'text': 'Services', 'external_icon':false  },
    { 'url': 'https://libguides.utk.edu/databases', 'text': 'Databases', 'external_icon':true },
    { 'url': 'https://digital.lib.utk.edu/', 'text': 'Digital Collections', 'external_icon':true },
    { 'url': '/spaces', 'text': 'Spaces','external_icon':false },
    { 'url': '/about', 'text': 'About the Libraries', 'external_icon':false }
] %}


<nav class="navbar navbar-expand-lg navbar-text py-0 text-smokey link-smokey underline-orange">
	<div class="container-fluid utk-header-footer-max mx-auto">
		<a href="{{ path('<front>') }}" class='navbar-brand d-flex align-items-center utk-site-logo py-0' id="utk-header-title">
			<img src="/themes/mccarthy_theme/images/favicon_logo.png" alt="">
			<span class='px-2 text-smokey'>
				LIBRARIES
			</span>
		</a>
		<button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#navbarToggler" aria-controls="navbarToggler" aria-expanded="false" aria-label="Toggle navigation">
			<span class="navbar-toggler-icon"></span>
		</button>
		<div class="utk-offcanvas offcanvas offcanvas-end" tabindex="-1" id="navbarToggler">
			<div class="offcanvas-header">
				<a href="" class='navbar-brand utk-site-logo'>
					<img src="/themes/mccarthy_theme/images/favicon_logo.png" alt="" class="d-inline-block align-text-top">
					<span class="offcanvas-title px-0 mx-0 fs-3" id="offcanvasNavbarLabel">LIBRARIES</span>
				</a>
				<button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
			</div>
			<div class="offcanvas-body" id="utk-navbar-header--links">
				<ul class="navbar-nav ms-auto d-flex align-items-lg-center utk-search-selector">
					<li class="navbar-item px-lg-2 px-md-1">
						<a class="navbar-link d-flex flex-row align-items-center" href="https://libanswers.utk.edu/">
							<svg width="24" height="24" fill="none" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
								<path d="M8.144 6.307c.434-.232.901-.306 1.356-.306.526 0 1.138.173 1.632.577.517.424.868 1.074.868 1.922 0 .975-.689 1.504-1.077 1.802l-.085.066c-.424.333-.588.511-.588.882a.75.75 0 0 1-1.5 0c0-1.134.711-1.708 1.162-2.062.513-.403.588-.493.588-.688 0-.397-.149-.622-.32-.761A1.115 1.115 0 0 0 9.5 7.5c-.295 0-.498.049-.65.13-.143.076-.294.21-.44.48a.75.75 0 1 1-1.32-.715c.264-.486.612-.853 1.054-1.089ZM9.5 15a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" fill="#ff8200"/>
								<path d="M9.5 3a7.5 7.5 0 0 0-6.797 10.673l-.725 2.842a1.25 1.25 0 0 0 1.504 1.524c.75-.18 1.903-.457 2.93-.702A7.5 7.5 0 1 0 9.5 3Zm-6 7.5a6 6 0 1 1 3.33 5.375l-.243-.121-.265.063-2.788.667c.2-.78.462-1.812.69-2.708l.07-.276-.13-.253A5.971 5.971 0 0 1 3.5 10.5Z" fill="#ff8200"/>
								<path d="M14.5 21c-1.97 0-3.761-.759-5.1-2h.1c.718 0 1.415-.089 2.081-.257.864.482 1.86.757 2.92.757.96 0 1.866-.225 2.669-.625l.243-.121.265.063c.921.22 1.965.445 2.74.61-.176-.751-.415-1.756-.642-2.651l-.07-.276.13-.253A5.971 5.971 0 0 0 20.5 13.5a5.995 5.995 0 0 0-2.747-5.042 8.443 8.443 0 0 0-.8-2.047 7.503 7.503 0 0 1 4.344 10.263c.253 1.008.51 2.1.672 2.803a1.244 1.244 0 0 1-1.468 1.5c-.727-.152-1.87-.396-2.913-.64A7.476 7.476 0 0 1 14.5 21Z" fill="#ff8200"/>
							</svg>
							<p class='p-0 m-0'>
								Get Help
								<span class='svg-settings fluent-icon-external' style="width:12px; height:12px; display:inline-block; position:relative; top:1px; margin-left:2px;"></span>
							</p>
						</a>
					</li>
					<li class="navbar-item px-lg-2 px-md-1">
						<a class="navbar-link d-flex flex-row align-items-center" href="/myaccounts">
							<svg width="24" height="24" fill="none" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
								<path d="M10.125 13.995a2.737 2.737 0 0 0-.617 1.5h-5.26a.749.749 0 0 0-.748.75v.577c0 .536.191 1.054.539 1.461 1.177 1.379 2.984 2.12 5.469 2.205.049.57.273 1.09.617 1.508h-.129c-3.145 0-5.531-.905-7.098-2.739A3.75 3.75 0 0 1 2 16.822v-.578c0-1.19.925-2.164 2.095-2.243l.154-.006h5.876Zm4.621-2.5h3c.648 0 1.18.492 1.244 1.123l.007.127-.001 1.25h1.25c.967 0 1.75.784 1.75 1.75v4.5a1.75 1.75 0 0 1-1.75 1.75h-8a1.75 1.75 0 0 1-1.75-1.75v-4.5c0-.966.784-1.75 1.75-1.75h1.25v-1.25c0-.647.492-1.18 1.123-1.243l.127-.007h3-3Zm5.5 4h-8a.25.25 0 0 0-.25.25v4.5c0 .138.112.25.25.25h8a.25.25 0 0 0 .25-.25v-4.5a.25.25 0 0 0-.25-.25Zm-2.75-2.5h-2.5v1h2.5v-1ZM9.997 2a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 1.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7Z" fill="#ff8200"/>
							</svg>
							<p class='p-0 m-0'>
								My Account
							</p>
						</a>
					</li>
					<li class="navbar-item px-lg-2 px-md-1">
						<a class="navbar-link d-flex flex-row align-items-center" href="/hours">
							<svg width="24" height="24" fill="none" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
								<path d="M12 2c5.523 0 10 4.478 10 10s-4.477 10-10 10S2 17.522 2 12 6.477 2 12 2Zm0 1.667c-4.595 0-8.333 3.738-8.333 8.333 0 4.595 3.738 8.333 8.333 8.333 4.595 0 8.333-3.738 8.333-8.333 0-4.595-3.738-8.333-8.333-8.333ZM11.25 6a.75.75 0 0 1 .743.648L12 6.75V12h3.25a.75.75 0 0 1 .102 1.493l-.102.007h-4a.75.75 0 0 1-.743-.648l-.007-.102v-6a.75.75 0 0 1 .75-.75Z" fill="#ff8200"/>
							</svg>
							<p class='p-0 m-0'>
								Hours
							</p>
						</a>
					</li>
					<li class="navbar-item dropdown px-lg-2 px-md-1 d-none d-lg-block utk-dropdown-menu">
						<a class="navbar-link dropdown-toggle d-flex flex-row align-items-center" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
							<svg width="24" height="24" fill="none" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
								<path d="M10 2.5a7.5 7.5 0 0 1 5.964 12.048l4.743 4.745a1 1 0 0 1-1.32 1.497l-.094-.083-4.745-4.743A7.5 7.5 0 1 1 10 2.5Zm0 2a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11Z" fill="#ff8200"/>
							</svg>
							<p class='p-0 m-0'>
								Find
							</p>
						</a>
						<ul class="dropdown-menu dropdown-menu-end">
							{% for link in find_dropdown_links %}
                                <li class="dropdown-item {{ link.li_extra_class | default('') }}">
                                    <a href="{{ link.url }}">
                                        {{ link.text }}
                                        {% if link.external_icon %}
                                            <span class='svg-settings fluent-icon-external' style="width:12px; height:12px; display:inline-block; position:relative; top:1px; margin-left:2px;"></span>
                                        {% endif %}
                                    </a>
                                </li>
                            {% endfor %}
						</ul>
					</li>
					{% for link in mobile_nav_links %}
                        <li class="navbar-item px-2 d-lg-none py-1">
                            <a class="navbar-link" href="{{ link.url }}">
                                {{ link.text }}
								{% if link.external_icon %}
									<span class='svg-settings fluent-icon-external' style="width:12px; height:12px; display:inline-block; position:relative; top:1px; margin-left:2px;"></span>
								{% endif %}
                            </a>
                        </li>
                    {% endfor %}
				</ul>
			</div>
		</div>
	</div>
</nav>

