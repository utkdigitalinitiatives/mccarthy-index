{#
/**
 * @file
 * Teaser (card) display for the "record" content type.
 */
#}
{% set annotated = content.field_annotated[0]["#markup"] %}
<a class="record-card" href="{{ url }}">
  <div class="record-card__cover-wrapper">
    {% if not node.field_cover.isEmpty() %}
      {{ content.field_cover }}
    {% else %}
      <div class="record-cover-placeholder" role="img" aria-label="{{ 'No cover available for @title'|t({'@title': node.label}) }}">
        {{ 'No cover available'|t }}
      </div>
    {% endif %}
  </div>
  <div class="record-card__body">
    <h3 class="record-card__title">{{ node.label }}</h3>
    
    {% if not node.field_creators.isEmpty() %}
      <div class="record-card__creators">{{ content.field_creators }}</div>
    {% endif %}
    
    {% if not node.field_publish_date.isEmpty() or annotated == "Yes" %}
      <div class="record-card__meta">
        {% if not node.field_publish_date.isEmpty() %}
          <span class="record-card__year">{{ node.field_publish_date.date|date('Y') }}</span>
        {% endif %}

        {% if annotated == "Yes" %}
          <span class="record-card__badge">Annotated</span>
        {% endif %}
      </div>
    {% endif %}
  </div>
</a>