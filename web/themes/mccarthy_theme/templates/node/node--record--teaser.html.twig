{#
/**
 * @file
 * Teaser (card) display for the "record" content type.
 *
 * Available variables:
 * - url: The record's URL.
 * - node: The record node entity.
 * - content.field_creators: Rendered creators field.
 *
 * @see template_preprocess_node()
 *
 * @ingroup themeable
 */
#}
<a class="record-card" href="{{ url }}">
  <img class="record-card__cover" src="https://picsum.photos/300/400" alt="Book cover placeholder" />
  <div class="record-card__body">
    <h3 class="record-card__title">{{ node.label }}</h3>
    {% if not node.field_creators.isEmpty() %}
      <div class="record-card__creators">{{ content.field_creators }}</div>
    {% endif %}
    {% if not node.field_publish_date.isEmpty() %}
      {# Year-only date; content.field_publish_date would render the full formatted date. #}
      <p class="record-card__year">{{ node.field_publish_date.date|date('Y') }}</p>
    {% endif %}
  </div>
</a>
