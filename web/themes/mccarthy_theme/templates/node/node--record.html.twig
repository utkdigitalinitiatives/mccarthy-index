{#
/**
 * @file
 * Full book-detail display for the "record" content type.
 */
#}
{{ attach_library('mccarthy_theme/node-record') }}
<article class="record-detail">

  <header class="record-detail__header">
    <h1 class="record-detail__title text-smokey">{{ label }}</h1>

    <div class="record-detail__body">
      <img class="record-detail__cover record-detail__media" src="https://picsum.photos/480/640" alt="Book cover placeholder" />

      <div class="record-detail__summary">
        <div class="record-detail__row-inline">
          {% if not node.field_creators.isEmpty() %}
            <dl class="record-field">
              <dt class="record-field__label text-smokey">Author</dt>
              <dd class="record-field__value text-smokey">{{ content.field_creators }}</dd>
            </dl>
          {% endif %}
          {% if not node.field_publisher.isEmpty() %}
            <dl class="record-field">
              <dt class="record-field__label text-smokey">Publisher</dt>
              <dd class="record-field__value link-link">
                {{ content.field_publisher }}
                {% if not node.field_publish_date.isEmpty() %}
                  <span class="record-field__meta text-smokey">({{ content.field_publish_date }})</span>
                {% endif %}
              </dd>
            </dl>
          {% endif %}
        </div>

        <div class="record-detail__divider"></div>

        <div class="record-detail__grid">
          <div class="record-detail__group">
            <h2 class="record-detail__group-title text-smokey">Identifiers</h2>
            {% if not node.field_isbn13.isEmpty() %}
              <dl class="record-field">
                <dt class="record-field__label text-smokey">ISBN13</dt>
                <dd class="record-field__value text-smokey">{{ content.field_isbn13 }}</dd>
              </dl>
            {% endif %}
            {% if not node.field_isbn10.isEmpty() %}
              <dl class="record-field">
                <dt class="record-field__label text-smokey">ISBN10</dt>
                <dd class="record-field__value text-smokey">{{ content.field_isbn10 }}</dd>
              </dl>
            {% endif %}
            {% if not node.field_oclc.isEmpty() %}
              <dl class="record-field">
                <dt class="record-field__label text-smokey">OCLC</dt>
                <dd class="record-field__value text-smokey">{{ content.field_oclc }}</dd>
              </dl>
            {% endif %}
          </div>
          <div class="record-detail__group">
            <h2 class="record-detail__group-title text-smokey">Classification</h2>
            <div class="record-detail__row-inline">
              {% if not node.field_lcc.isEmpty() %}
                <dl class="record-field">
                  <dt class="record-field__label text-smokey">LCC</dt>
                  <dd class="record-field__value text-smokey">{{ content.field_lcc }}</dd>
                </dl>
              {% endif %}
              {% if not node.field_lccn.isEmpty() %}
                <dl class="record-field">
                  <dt class="record-field__label text-smokey">LCCN</dt>
                  <dd class="record-field__value text-smokey">{{ content.field_lccn }}</dd>
                </dl>
              {% endif %}
            </div>
          </div>
        </div>

        <div class="record-detail__divider"></div>

        <div class="record-detail__row-inline record-detail__row-inline--four">
          {% if not node.field_collection.isEmpty() %}
            <dl class="record-field">
              <dt class="record-field__label text-smokey">Collection</dt>
              <dd class="record-field__value text-smokey">{{ content.field_collection }}</dd>
            </dl>
          {% endif %}
          {% if not node.field_length.isEmpty() %}
            <dl class="record-field">
              <dt class="record-field__label text-smokey">Length</dt>
              <dd class="record-field__value text-smokey">{{ content.field_length }}</dd>
            </dl>
          {% endif %}
          {% if not node.field_date_added.isEmpty() %}
            <dl class="record-field">
              <dt class="record-field__label text-smokey">Date Added</dt>
              <dd class="record-field__value text-smokey">{{ content.field_date_added }}</dd>
            </dl>
          {% endif %}
          {% if not node.field_copies.isEmpty() %}
            <dl class="record-field">
              <dt class="record-field__label text-smokey">Copies</dt>
              <dd class="record-field__value text-smokey">{{ content.field_copies }}</dd>
            </dl>
          {% endif %}
        </div>

        <div class="record-detail__divider"></div>

        <div class="record-detail__box record-detail__row-inline">
          {% if not node.field_final_destination.isEmpty() %}
            <dl class="record-field">
              <dt class="record-field__label text-smokey">Final Destination</dt>
              <dd class="record-field__value link-link">{{ content.field_final_destination }}</dd>
            </dl>
          {% endif %}
          <dl class="record-field">
            <dt class="record-field__label text-smokey">Annotated</dt>
            <dd class="record-field__value">
              {% if node.field_annotated.value %}
                <span class="record-detail__badge record-detail__badge--yes text-smokey">Yes</span>
              {% else %}
                <span class="record-detail__badge record-detail__badge--no text-smokey">No</span>
              {% endif %}
            </dd>
          </dl>
        </div>

        {% if not node.field_provenance.isEmpty() %}
          <div class="record-detail__provenance link-link">
            <h2 class="record-detail__section-title">Provenance</h2>
            <p>{{ content.field_provenance.0 }}</p>
          </div>
        {% endif %}
      </div>
    </div>
  </header>

  {% if not node.field_publication_description.isEmpty() %}
    <section class="record-detail__section">
      <h2 class="record-detail__section-title">Description</h2>
      <div class="record-detail__description text-smokey">
        {{ content.field_publication_description }}
      </div>
    </section>
  {% endif %}

  {% if not node.field_notes.isEmpty() %}
    <section class="record-detail__section">
      <h2 class="record-detail__section-title">Notes</h2>
      <div class="record-annotation">
        <img class="record-annotation__image record-detail__media" src="https://picsum.photos/500/650" alt="Annotated manuscript page placeholder" />
        <p class="record-annotation__quote text-smokey">{{ content.field_notes.0 }}</p>
      </div>
    </section>
  {% endif %}
</article>
