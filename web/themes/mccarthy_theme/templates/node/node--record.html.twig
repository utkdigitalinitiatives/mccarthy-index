{#
/**
 * @file
 * Full book-detail display for the "record" content type.
 */
#}
{{ attach_library('mccarthy_theme/node-record') }}
<article class="record-detail">

  <header class="record-detail__header">
    <h1 class="record-detail__title text-smokey">{{ label }}</h1>

    <div class="record-detail__body">
      <img class="record-detail__cover" src="https://picsum.photos/480/640" alt="Book cover placeholder" />

      <div class="record-detail__summary">
        <dl class="record-detail__list">
        <div class="record-detail__row">
          <dt class="record-detail__label">Author</dt>
          <dd class="record-detail__value text-smokey">{{ content.field_creators }}</dd>
        </div>
        <div class="record-detail__row">
          <dt class="record-detail__label">Publisher</dt>
          <dd class="record-detail__value link-link">{{ content.field_publisher }}</dd>
        </div>
        <div class="record-detail__row">
          <dt class="record-detail__label">Publish Date</dt>
          <dd class="record-detail__value text-smokey">{{ content.field_publish_date }}</dd>
        </div>
        <div class="record-detail__row">
          <dt class="record-detail__label">ISBN13</dt>
          <dd class="record-detail__value text-smokey">{{ content.field_isbn13 }}</dd>
        </div>
        <div class="record-detail__row">
          <dt class="record-detail__label">ISBN10</dt>
          <dd class="record-detail__value text-smokey">{{ content.field_isbn10 }}</dd>
        </div>
        <div class="record-detail__row">
          <dt class="record-detail__label">Record Number</dt>
          <dd class="record-detail__value text-smokey">{{ content.field_record_number }}</dd>
        </div>
        <div class="record-detail__row">
          <dt class="record-detail__label">Collection</dt>
          <dd class="record-detail__value text-smokey">{{ content.field_collection }}</dd>
        </div>
        <div class="record-detail__row">
          <dt class="record-detail__label">LCC</dt>
          <dd class="record-detail__value text-smokey">{{ content.field_lcc }}</dd>
        </div>
        <div class="record-detail__row">
          <dt class="record-detail__label">LCCN</dt>
          <dd class="record-detail__value text-smokey">{{ content.field_lccn }}</dd>
        </div>
        <div class="record-detail__row">
          <dt class="record-detail__label">OCLC</dt>
          <dd class="record-detail__value text-smokey">{{ content.field_oclc }}</dd>
        </div>
        <div class="record-detail__row">
          <dt class="record-detail__label">Length</dt>
          <dd class="record-detail__value text-smokey">{{ content.field_length }}</dd>
        </div>
        <div class="record-detail__row">
          <dt class="record-detail__label">Date Added</dt>
          <dd class="record-detail__value text-smokey">{{ content.field_date_added }}</dd>
        </div>
        <div class="record-detail__row">
          <dt class="record-detail__label">Copies</dt>
          <dd class="record-detail__value text-smokey">{{ content.field_copies }}</dd>
        </div>
        <div class="record-detail__row">
          <dt class="record-detail__label">Final Destination</dt>
          <dd class="record-detail__value link-link">{{ content.field_final_destination }}</dd>
        </div>
        <div class="record-detail__row">
          <dt class="record-detail__label">Annotated</dt>
          <dd class="record-detail__value">
            {% if node.field_annotated.value %}
              <span class="record-detail__badge record-detail__badge--yes">Yes</span>
            {% else %}
              <span class="record-detail__badge record-detail__badge--no">No</span>
            {% endif %}
          </dd>
        </div>
      </dl>

      {% if not node.field_provenance.isEmpty() %}
        <div class="record-detail__provenance link-link">
          <h2 class="record-detail__section-title">Provenance</h2>
          <p>{{ content.field_provenance }}</p>
        </div>
      {% endif %}
      </div>
    </div>
  </header>

  {% if not node.field_publication_description.isEmpty() %}
    <section class="record-detail__section">
      <h2 class="record-detail__section-title">Description</h2>
      <div class="record-detail__description text-smokey">
        {{ content.field_publication_description }}
      </div>
    </section>
  {% endif %}

  {% if not node.field_notes.isEmpty() %}
    <section class="record-detail__section">
      <h2 class="record-detail__section-title">Notes</h2>
      <div class="record-annotation">
        <img class="record-annotation__image" src="https://picsum.photos/500/650" alt="Annotated manuscript page placeholder" />
        <p class="record-annotation__quote text-smokey">{{ content.field_notes }}</p>
      </div>
    </section>
  {% endif %}

</article>
