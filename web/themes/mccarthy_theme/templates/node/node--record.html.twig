{#
/**
 * @file
 * Full book-detail display for the "record" content type.
 */
#}
{{ attach_library('mccarthy_theme/node-record') }}
<article class="record-detail">

  <header class="record-detail__header">
    <h1 class="record-detail__title text-smokey">{{ label }}</h1>

    <div class="record-detail__body">
      <img class="record-detail__cover" src="https://picsum.photos/480/640" alt="Book cover placeholder" />

      <div class="record-detail__summary">
        <div class="record-detail__row-inline">
          <div class="record-field">
            <span class="record-field__label">Author</span>
            <div class="record-field__value text-smokey">{{ content.field_creators }}</div>
          </div>
          <div class="record-field">
            <span class="record-field__label">Publisher</span>
            <div class="record-field__value link-link">
              {{ content.field_publisher }}
              {% if not node.field_publish_date.isEmpty() %}
                <span class="record-field__meta text-smokey">({{ content.field_publish_date }})</span>
              {% endif %}
            </div>
          </div>
        </div>

        <div class="record-detail__divider"></div>

        <div class="record-detail__grid">
          <div class="record-detail__group">
            <h2 class="record-detail__group-title">Identifiers</h2>
            <div class="record-field">
              <span class="record-field__label">ISBN13</span>
              <div class="record-field__value text-smokey">{{ content.field_isbn13 }}</div>
            </div>
            <div class="record-field">
              <span class="record-field__label">ISBN10</span>
              <div class="record-field__value text-smokey">{{ content.field_isbn10 }}</div>
            </div>
            <div class="record-field">
              <span class="record-field__label">OCLC</span>
              <div class="record-field__value text-smokey">{{ content.field_oclc }}</div>
            </div>
          </div>
          <div class="record-detail__group">
            <h2 class="record-detail__group-title">Classification</h2>
            <div class="record-detail__row-inline">
              <div class="record-field">
                <span class="record-field__label">LCC</span>
                <div class="record-field__value text-smokey">{{ content.field_lcc }}</div>
              </div>
              <div class="record-field">
                <span class="record-field__label">LCCN</span>
                <div class="record-field__value text-smokey">{{ content.field_lccn }}</div>
              </div>
            </div>
          </div>
        </div>

        <div class="record-detail__divider"></div>

        <div class="record-detail__row-inline record-detail__row-inline--four">
          <div class="record-field">
            <span class="record-field__label">Collection</span>
            <div class="record-field__value text-smokey">{{ content.field_collection }}</div>
          </div>
          <div class="record-field">
            <span class="record-field__label">Length</span>
            <div class="record-field__value text-smokey">{{ content.field_length }}</div>
          </div>
          <div class="record-field">
            <span class="record-field__label">Date Added</span>
            <div class="record-field__value text-smokey">{{ content.field_date_added }}</div>
          </div>
          <div class="record-field">
            <span class="record-field__label">Copies</span>
            <div class="record-field__value text-smokey">{{ content.field_copies }}</div>
          </div>
        </div>

        <div class="record-detail__divider"></div>

        <div class="record-detail__box record-detail__row-inline">
          <div class="record-field">
            <span class="record-field__label">Final Destination</span>
            <div class="record-field__value link-link">{{ content.field_final_destination }}</div>
          </div>
          <div class="record-field">
            <span class="record-field__label">Annotated</span>
            <div class="record-field__value">
              {% if node.field_annotated.value %}
                <span class="record-detail__badge record-detail__badge--yes">Yes</span>
              {% else %}
                <span class="record-detail__badge record-detail__badge--no">No</span>
              {% endif %}
            </div>
          </div>
        </div>

        {% if not node.field_provenance.isEmpty() %}
          <div class="record-detail__provenance link-link">
            <h2 class="record-detail__section-title">Provenance</h2>
            <p>{{ content.field_provenance.0 }}</p>
          </div>
        {% endif %}
      </div>
    </div>
  </header>

  {% if not node.field_publication_description.isEmpty() %}
    <section class="record-detail__section">
      <h2 class="record-detail__section-title">Description</h2>
      <div class="record-detail__description text-smokey">
        {{ content.field_publication_description }}
      </div>
    </section>
  {% endif %}

  {% if not node.field_notes.isEmpty() %}
    <section class="record-detail__section">
      <h2 class="record-detail__section-title">Notes</h2>
      <div class="record-annotation">
        <img class="record-annotation__image" src="https://picsum.photos/500/650" alt="Annotated manuscript page placeholder" />
        <p class="record-annotation__quote text-smokey">{{ content.field_notes.0 }}</p>
      </div>
    </section>
  {% endif %}
</article>
