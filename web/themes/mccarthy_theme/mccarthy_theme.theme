<?php

use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Render\Element\Checkboxes;

/**
 * Implements hook_form_BASE_FORM_ID_alter() for views_exposed_form.
 */
function mccarthy_theme_form_views_exposed_form_alter(array &$form, FormStateInterface $form_state, $form_id) {
  $view = $form_state->get('view');
  if (!$view || $view->id() !== 'search') {
    return;
  }

  if (isset($form['search_api_fulltext'])) {
    $form['search_api_fulltext']['#title'] = t('Search the database');
    $form['search_api_fulltext']['#title_display'] = 'invisible';
    $form['search_api_fulltext']['#attributes']['placeholder'] = t('Search the database for books...');
  }

  if (isset($form['actions']['submit'])) {
    $form['actions']['submit']['#value'] = t('Search');
  }

  if (isset($form['search_api_fulltext_searched_fields'])) {
    $fields = &$form['search_api_fulltext_searched_fields'];
    $fields['#type'] = 'checkboxes';
    $fields['#title'] = t('Search within');
    $fields['#options'] = array_intersect_key([
      'title' => t('Title'),
      'field_creators' => t('Authors'),
    ], $fields['#options']);
    $fields['#description'] = t('Select fields to narrow your search. Leave both unchecked to search all fields.');
    $fields['#element_validate'][] = 'mccarthy_theme_validate_search_fields';
    unset($fields['#multiple'], $fields['#size']);
  }
}

/**
 * Removes unchecked values before Search API reads the selected fields.
 */
function mccarthy_theme_validate_search_fields(array &$element, FormStateInterface $form_state, array &$complete_form) {
  $checked = Checkboxes::getCheckedCheckboxes($element['#value']);
  $form_state->setValueForElement($element, array_combine($checked, $checked));
}
